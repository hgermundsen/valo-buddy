datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String    @unique
  password Password?

  vods     Vod[]
  strats   Strat[]
  StratTag StratTag[]
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Vod {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  isPublic Boolean @default(false)

  map                     String
  agent                   String
  title                   String
  date                    DateTime
  rank                    String
  roundsWon               Int      @db.SmallInt
  roundsLost              Int      @db.SmallInt
  kills                   Int      @db.SmallInt
  deaths                  Int      @db.SmallInt
  assists                 Int      @db.SmallInt
  valoplantLink           String
  trackerLink             String
  tags                    VodTag[]
  description             String
  unlistedYoutubeVideoURL String
  relatedStrats           Strat[]
}

model VodTag {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name String
  vods Vod[]
}

model Strat {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  isPublic Boolean @default(false)

  map               String
  agent             String
  title             String
  tags              StratTag[]
  attackerSideNotes String?
  defenderSideNotes String?
  relatedVods       Vod[]
  images            StratImage[]
}

model StratTag {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  name   String  @unique
  strats Strat[]
}

model StratImage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  associatedStrat Strat  @relation(fields: [stratId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stratId         String

  imageURL String
}
