datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String    @unique
  password Password?

  notes  Note[]
  vods   Vod[]
  strats Strat[]
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Note {
  id    String @id @default(cuid())
  title String
  body  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
}

model Vod {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  isPublic Boolean @default(false)

  map                     String
  agent                   String
  title                   String
  date                    DateTime
  rank                    String
  roundsWon               Int      @db.SmallInt
  roundsLost              Int      @db.SmallInt
  kills                   Int      @db.SmallInt
  deaths                  Int      @db.SmallInt
  assists                 Int      @db.SmallInt
  valoplantLink           String
  trackerLink             String
  tags                    VodTag[]
  description             String
  unlistedYoutubeVideoURL String
  relatedStrats           Strat[]
}

model VodTag {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name String
  vods Vod[]
}

model Strat {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  isPublic Boolean @default(false)

  map                                      String
  agent                                    String
  title                                    String
  tags                                     StratTag[]
  miscLinks                                String[]
  lineupsAndAbilityTricksAttackerSideNotes String?
  lineupsAndAbilityTricksDefenderSideNotes String?
  earlyRoundAttackerSideNotes              String?
  earlyRoundDefenderSideNotes              String?
  midRoundAttackerSideNotes                String?
  midRoundDefenderSideNotes                String?
  lateRoundAttackerSideNotes               String?
  lateRoundDefenderSideNotes               String?
  miscNotes                                String?
  relatedVods                              Vod[]
  images                                   StratImage[]
}

model StratTag {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name   String
  strats Strat[]
}

enum StratSection {
  LINEUPS_AND_ABILITY_TRICKS_ATTACKER_SIDE
  LINEUPS_AND_ABILITY_TRICKS_DEFENDER_SIDE
  EARLY_ROUND_ATTACKER_SIDE
  EARLY_ROUND_DEFENDER_SIDE
  MID_ROUND_ATTACKER_SIDE
  MID_ROUND_DEFENDER_SIDE
  LATE_ROUND_ATTACKER_SIDE
  LATE_ROUND_DEFENDER_SIDE
  MISC
}

model StratImage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  associatedStrat Strat  @relation(fields: [stratId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stratId         String

  imageURL     String
  stratSection StratSection @default(MISC)
}
